# WhatsApp Web (Selenium) — required
WHATSAPP_CHAT_NAME=Your exact WhatsApp contact/chat name

# Persistent Chrome profile (QR scan saved here after first login)
CHROME_USER_DATA_DIR=data/chrome_whatsapp_profile
WHATSAPP_WEB_URL=https://web.whatsapp.com
WHATSAPP_LOGIN_TIMEOUT_SECONDS=180
SELENIUM_IMPLICIT_WAIT_SECONDS=10
CHROME_HEADLESS=false

# Gmail OAuth files (place credentials.json in project root)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify

# Polling and state
POLL_INTERVAL_SECONDS=30
STATE_FILE_PATH=data/processed_ids.json
WHATSAPP_MAX_CHUNK_CHARS=4000
